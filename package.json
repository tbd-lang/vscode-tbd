{
  "name": "tbd-syntax",
  "displayName": "TBD Syntax",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tbd",
        "aliases": [
          "TBD",
          "tbd"
        ],
        "extensions": [
          ".tbd"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tbd",
        "scopeName": "source.tbd",
        "path": "./syntaxes/tbd.tmLanguage.json"
      }
    ]
  }
}
