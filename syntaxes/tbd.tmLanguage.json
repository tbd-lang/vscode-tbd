{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "tbd",
  "scopeName": "source.tbd",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#import" },
    { "include": "#module-declaration" },
    { "include": "#type-declaration" },
    { "include": "#function-declaration" },
    { "include": "#named-field" },
    { "include": "#keywords" },
    { "include": "#booleans" },
    { "include": "#builtin-types" },
    { "include": "#type-variables" },
    { "include": "#module-access" },
    { "include": "#constructors" },
    { "include": "#numbers" },
    { "include": "#function-call" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#characters" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.tbd",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.tbd",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.tbd",
          "match": "\\\\."
        }
      ]
    },
    "import": {
      "match": "\\b(import)\\b",
      "captures": {
        "1": { "name": "keyword.control.import.tbd" }
      }
    },
    "module-declaration": {
      "match": "\\b(module)\\s+([A-Z][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.module.tbd" },
        "2": { "name": "entity.name.namespace.tbd" }
      }
    },
    "type-declaration": {
      "match": "\\b(type)\\s+([a-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.type.tbd" },
        "2": { "name": "entity.name.type.tbd" }
      }
    },
    "function-declaration": {
      "match": "\\b(pub\\s+)?(fun|extern)\\s+([a-z_][A-Za-z0-9_']*)",
      "captures": {
        "1": { "name": "keyword.declaration.function.tbd" },
        "2": { "name": "keyword.declaration.function.tbd" },
        "3": { "name": "entity.name.function.tbd" }
      }
    },
    "named-field": {
      "match": "(?<=[(,])\\s*([a-z_][A-Za-z0-9_]*)(?=\\s*:)",
      "captures": {
        "1": { "name": "variable.parameter.tbd" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tbd",
          "match": "\\blet[!?](?=\\s)"
        },
        {
          "name": "keyword.control.tbd",
          "match": "\\b(fun|extern|pub|match|let|in|and|then|fun|end|when|is|as|receive|send|spawn|self)\\b"
        }
      ]
    },
    "booleans": {
      "name": "constant.language.boolean.tbd",
      "match": "\\b(true|false)\\b"
    },
    "builtin-types": {
      "name": "support.type.tbd",
      "match": "\\b(unit|int|float|bool|string|list)\\b"
    },
    "type-variables": {
      "name": "variable.parameter.type.tbd",
      "match": "\\$[a-z_][A-Za-z0-9_]*"
    },
    "module-access": {
      "match": "\\b([A-Z][A-Za-z0-9_]*)(?=\\.)",
      "captures": {
        "1": { "name": "entity.name.namespace.tbd" }
      }
    },
    "constructors": {
      "name": "variable.other.enummember.tbd",
      "match": "[A-Z][A-Za-z0-9_]*(?!\\.)"
    },
    "numbers": {
      "name": "constant.numeric.tbd",
      "match": "\\b[0-9]+\\b"
    },
    "characters": {
      "name": "string.quoted.single.tbd",
      "match": "'[\\s\\S]'"
    },
    "function-call": {
      "match": "\\b([a-z_][A-Za-z0-9_']*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.tbd" }
      }
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.pipe.tbd", "match": "\\|>" },
        { "name": "keyword.operator.arrow.tbd", "match": "->" },
        { "name": "keyword.operator.cons.tbd", "match": "::" },
        { "name": "keyword.operator.and.tbd", "match": "\\&\\&" },
        { "name": "keyword.operator.or.tbd", "match": "\\|\\|" },
        { "name": "keyword.operator.cons.tbd", "match": "::" },
        { "name": "keyword.operator.cons.tbd", "match": "::" },
        { "name": "keyword.operator.comparison.tbd", "match": "(<=|>=|<|>|=)" },
        {
          "name": "keyword.operator.arithmetic.tbd",
          "match": "(\\+|-|\\*|/|%|\\^)"
        },
        { "name": "keyword.operator.match.tbd", "match": "\\|" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.tbd", "match": "[,;:]" },
        { "name": "punctuation.section.parens.tbd", "match": "[()]" },
        { "name": "punctuation.section.brackets.tbd", "match": "[\\[\\]]" },
        { "name": "punctuation.section.braces.tbd", "match": "[{}]" }
      ]
    }
  }
}
