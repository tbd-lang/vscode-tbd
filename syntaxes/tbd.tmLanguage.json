{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "tbd",
  "scopeName": "source.tbd",
  "patterns": [{ "include": "#shebang" }, { "include": "#form" }],
  "repository": {
    "shebang": {
      "name": "comment",
      "match": "^#!.*$"
    },
    "form": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#parens" },
        { "include": "#list" },
        { "include": "#tuple" },
        { "include": "#map" },
        { "include": "#binary" },
        { "include": "#keyword" },
        { "include": "#atom" },
        { "include": "#string" },
        { "include": "#char" },
        { "include": "#boolean" },
        { "include": "#number" }
      ]
    },

    "comment": {
      "match": "--.*$|#!*$",
      "name": "comment"
    },

    "parens": {
      "begin": "\\(",
      "beginCaptures": {
        "0": { "name": "punctuation" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation" }
      },
      "patterns": [{ "include": "#form" }]
    },

    "list": {
      "begin": "\\[",
      "beginCaptures": {
        "0": { "name": "punctuation" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation" }
      },
      "patterns": [{ "include": "#form" }]
    },

    "tuple": {
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation" }
      },
      "patterns": [{ "include": "#form" }]
    },

    "map": {
      "begin": "#\\{",
      "beginCaptures": {
        "0": { "name": "punctuation" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation" }
      },
      "patterns": [{ "include": "#form" }]
    },

    "binary": {
      "begin": "\\<\\<",
      "beginCaptures": {
        "0": { "name": "punctuation" }
      },
      "end": "\\>\\>",
      "endCaptures": {
        "0": { "name": "punctuation" }
      },
      "patterns": [{ "include": "#form" }]
    },

    "keyword": {
      "name": "keyword",
      "match": "\\b(?:if|function|let|match|import|fun|external)\\b"
    },

    "atom": {
      "name": "constant.language.keyword",
      "match": "(?<![a-zA-Z0-9]):[a-z][a-zA-Z0-9\\-]*"
    },

    "string": {
      "name": "string.quoted.double",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape"
        }
      ]
    },

    "char": {
      "name": "string.quoted.single.char",
      "match": "'(?:\\\\.|[^\\\\'])'"
    },

    "boolean": {
      "name": "constant.language.boolean",
      "match": "\\b(?:true|false)\\b"
    },

    "number": {
      "name": "constant.numeric",
      "match": "\\b(?:\\d+\\.\\d+|\\d+)\\b"
    }
  }
}
