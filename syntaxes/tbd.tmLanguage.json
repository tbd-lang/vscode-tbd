{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TBD",
  "scopeName": "source.tbd",
  "patterns": [
    { "include": "#comments" },
    { "include": "#lists" },
    { "include": "#tuples" },
    { "include": "#calls" },
    { "include": "#qualified-names" },
    { "include": "#symbols" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.tbd",
          "match": "--.*$"
        }
      ]
    },
    "qualified-names": {
      "patterns": [
        {
          "match": "\\b(?:([A-Za-z_][A-Za-z0-9_]*)(\\.))+([A-Z][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "entity.name.namespace.tbd" },
            "2": { "name": "punctuation.separator.namespace.tbd" },
            "3": { "name": "entity.name.namespace.tbd" }
          }
        }
      ]
    },

    "calls": {
      "patterns": [
        {
          "name": "meta.expression.call.tbd",
          "begin": "\\(",
          "beginCaptures": {
            "0": { "name": "punctuation.section.parens.begin.tbd" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.section.parens.end.tbd" }
          },
          "patterns": [
            {
              "name": "keyword.control.tbd",
              "match": "\\G\\s*(?:public\\s+function|function|define|match|let|fun|import|if)\\b"
            },
            { "include": "#qualified-names" },
            { "include": "#symbols" },
            {
              "name": "entity.name.function.call.tbd",
              "match": "\\G\\s*([^\\s\\(\\)\\[\\]\\{\\}\"]+)"
            },
            { "include": "#comments" },
            { "include": "#lists" },
            { "include": "#tuples" },
            { "include": "#calls" }
          ]
        }
      ]
    },

    "lists": {
      "patterns": [
        {
          "name": "meta.sequence.list.tbd",
          "begin": "\\[",
          "beginCaptures": {
            "0": { "name": "punctuation.section.brackets.begin.tbd" }
          },
          "end": "\\]",
          "endCaptures": {
            "0": { "name": "punctuation.section.brackets.end.tbd" }
          },
          "patterns": [
            { "include": "#comments" },
            { "include": "#qualified-names" },
            { "include": "#symbols" },
            {
              "name": "entity.name.function.call.tbd",
              "match": "\\G\\s*([^\\s\\(\\)\\[\\]\\{\\}\"]+)"
            },
            { "include": "#comments" },
            { "include": "#lists" },
            { "include": "#tuples" },
            { "include": "#calls" }
          ]
        }
      ]
    },

    "tuples": {
      "patterns": [
        {
          "name": "meta.sequence.tuple.tbd",
          "begin": "\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.section.braces.begin.tbd" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.braces.end.tbd" }
          },
          "patterns": [
            { "include": "#comments" },
            { "include": "#qualified-names" },
            { "include": "#symbols" },
            {
              "name": "entity.name.function.call.tbd",
              "match": "\\G\\s*([^\\s\\(\\)\\[\\]\\{\\}\"]+)"
            },
            { "include": "#comments" },
            { "include": "#lists" },
            { "include": "#tuples" },
            { "include": "#calls" }
          ]
        }
      ]
    },

    "symbols": {
      "patterns": [
        {
          "name": "string.quoted.double.tbd",
          "match": "\"(?:\\\\.|[^\"\\\\])*\""
        },
        {
          "name": "constant.language.boolean.tbd",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.numeric.float.tbd",
          "match": "-?\\d+\\.\\d+"
        },
        {
          "name": "constant.numeric.integer.tbd",
          "match": "-?\\d+"
        },
        {
          "name": "variable.other.enummember.tbd",
          "match": "\\b[A-Z][A-Za-z_][A-Za-z0-9_-]*\\b(?!\\.)"
        }
      ]
    }
  }
}
